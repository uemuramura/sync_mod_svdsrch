<setup>
  <block title="Git 接続" endpoint="syncgitmdsearch_settings" entity="git">
    <text>HTTPS で GitHub / GitLab / Bitbucket から取得します。トークンは password.conf に暗号化保存されます。SSH と git コマンドは使いません。</text>
    <input field="repo_url">
      <label>リポジトリ URL (https のみ)</label>
      <type>text</type>
    </input>
    <input field="provider">
      <label>プロバイダ (auto / github / gitlab / bitbucket)</label>
      <type>text</type>
    </input>
    <input field="api_base_url">
      <label>API ベース URL（任意）</label>
      <type>text</type>
    </input>
    <input field="branch">
      <label>ブランチ</label>
      <type>text</type>
    </input>
    <input field="md_glob">
      <label>Markdown glob</label>
      <type>text</type>
    </input>
    <input field="auth_type">
      <label>認証方式 (https_token / https_basic)</label>
      <type>text</type>
    </input>
    <input field="username">
      <label>ユーザー名</label>
      <type>text</type>
    </input>
    <input field="password">
      <label>パスワード / トークン</label>
      <type>password</type>
    </input>
    <input field="target_app">
      <label>saved search の保存先アプリ</label>
      <type>text</type>
    </input>
    <input field="target_owner">
      <label>owner</label>
      <type>text</type>
    </input>
    <input field="overwrite">
      <label>既存 saved search を上書きする (true / false)</label>
      <type>text</type>
    </input>
  </block>
</setup>
