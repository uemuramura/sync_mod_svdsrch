[git]
repo_url = <https URL>
branch = <string>
md_glob = <string>
provider = auto | github | gitlab | bitbucket
api_base_url = <https URL>
auth_type = https_token | https_basic
username = <string>
target_app = <string>
target_owner = <string>
overwrite = <true|false>
skip_files = <comma-separated file names>
